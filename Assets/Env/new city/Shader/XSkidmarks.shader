					    u_xlat16_1 = u_xlat10_0.w * vs_COLOR0.w;
					    SV_Target0.xyz = u_xlat10_0.xyz * _Color.xyz;
					    u_xlat16_1 = u_xlat16_1 * _Color.w;
					    u_xlatb0 = 0.0>=u_xlat16_1;
					    SV_Target0.w = u_xlat16_1;
					    if(u_xlatb0){discard;}
					    return;
